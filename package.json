{
  "name": "@aiui-sports/agents-benchmark",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for three source-available AIUI sports apps plus an Apache-2.0 evidence and governance Hub.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EasonZhu1997/AIUI-Sports-Agents.git"
  },
  "homepage": "https://github.com/EasonZhu1997/AIUI-Sports-Agents#readme",
  "bugs": {
    "url": "https://github.com/EasonZhu1997/AIUI-Sports-Agents/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20 <26"
  },
  "scripts": {
    "test": "npm run validate && npm run test:export-policy",
    "validate": "node scripts/validate.mjs && node scripts/validate-licensing.mjs",
    "validate:licensing": "node scripts/validate-licensing.mjs",
    "test:export-policy": "node scripts/test-export-policy.mjs",
    "report": "node scripts/report.mjs",
    "source:manifest": "node scripts/source-manifest.mjs",
    "audit:local": "node scripts/audit-local.mjs",
    "audit:local:strict": "node scripts/audit-local.mjs --strict",
    "export:dry": "node scripts/export-project.mjs",
    "export:local": "node scripts/export-project.mjs --write"
  },
  "license": "Apache-2.0"
}
